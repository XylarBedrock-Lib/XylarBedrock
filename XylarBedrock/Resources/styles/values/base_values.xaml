<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--#region Text / Glyphs -->

    <SolidColorBrush x:Key="PrimaryText.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SecondaryText.Foreground" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="TertiaryText.Foreground" Color="#696969"/>
    <SolidColorBrush x:Key="DisabledText.Foreground" Color="#B0B0B0"/>

    <SolidColorBrush x:Key="Seperator.Background" Color="#E0E0E0"/>

    <SolidColorBrush x:Key="OveralElements.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusableElement.Background" Color="#5F5FFFF"/>

    <!--#endregion-->

    <!--#region Backgrounds -->

    <SolidColorBrush x:Key="Background.Primary" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Background.Secondary" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="Background.Dialog" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Background.Tertiary" Color="#FFFFFF"/>

    <!--#endregion-->

    <!--#region Option Mark -->

    <SolidColorBrush x:Key="OptionMark.Static.Background" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="OptionMark.Static.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="OptionMark.Static.Glyph" Color="#1A1A1A"/>

    <SolidColorBrush x:Key="OptionMark.MouseOver.Background" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Border" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Glyph" Color="#1A1A1A"/>

    <SolidColorBrush x:Key="OptionMark.Pressed.Background" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Border" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Glyph" Color="#1A1A1A"/>

    <SolidColorBrush x:Key="OptionMark.Static.Checked.Background" Color="#00B359"/>
    <SolidColorBrush x:Key="OptionMark.Static.Checked.Border" Color="#00B359"/>
    <SolidColorBrush x:Key="OptionMark.Static.Checked.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="OptionMark.MouseOver.Checked.Background" Color="#00D166"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Checked.Border" Color="#00D166"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Checked.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="OptionMark.Pressed.Checked.Background" Color="#008C47"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Checked.Border" Color="#008C47"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Checked.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="OptionMark.Focused.Border" Color="#4A4A4A"/>

    <!--#endregion-->

    <!--#region Generic Button -->

    <SolidColorBrush x:Key="Button.Static.Background" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="Button.Static.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#A0A0A0"/>

    <!--#endregion-->

    <!--#region ScrollBar -->

    <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double>
    <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">8</sys:Double>

    <SolidColorBrush x:Key="ScrollBar.Static.Background" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Border" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Glyph" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Glyph" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Glyph" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Glyph" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Background" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Border" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Background" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Background" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Border" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="#D0D0D0"/>

    <!--#endregion-->

    <!--#region Combobox -->

    <sys:Double x:Key="ComboBox_VerticalScrollBarWidthKey">5</sys:Double>
    <sys:Double x:Key="ComboBox_HorizontalScrollBarHeightKey">5</sys:Double>

    <SolidColorBrush x:Key="ComboBox.Static.Background" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ComboBox.Static.Border" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="#1A1A1A"/>

    <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="#1A1A1A"/>

    <SolidColorBrush x:Key="ComboBox.Pressed.Background" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Border" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="#1A1A1A"/>

    <SolidColorBrush x:Key="ComboBox.Focused.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBox.Focused.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ComboBox.Focused.Glyph" Color="#1A1A1A"/>

    <SolidColorBrush x:Key="ComboBoxItem.Selected.Background" Color="#00B359"/>
    <SolidColorBrush x:Key="ComboBoxItem.Selected.Border" Color="#00B359"/>

    <SolidColorBrush x:Key="ScrollBar_Combobox.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBar_Combobox.Static.Border" Color="Transparent"/>

    <SolidColorBrush x:Key="ScrollBar_Combobox.MouseOver.Thumb" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="ScrollBar_Combobox.Pressed.Thumb" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="ScrollBar_Combobox.Static.Thumb" Color="#D0D0D0"/>

    <SolidColorBrush x:Key="ComboBox.Dropdown.Static.Background" Color="#FAFAFA"/>

    <!--#endregion-->

    <!--#region TextBox -->

    <SolidColorBrush x:Key="TextBox.Static.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextBox.Static.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#E0E0E0"/>

    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="TextBox.MouseOver.Background" Color="#FAFAFA"/>

    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="TextBox.Focus.Background" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextBox.SelectionBrush" Color="#B3E5FC"/>

    <!--#endregion-->

    <!--#region Expander -->

    <SolidColorBrush x:Key="Expander.MouseOver.Circle.Stroke" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.MouseOver.Circle.Fill" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Expander.Pressed.Circle.Stroke" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Pressed.Circle.Fill" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Pressed.Arrow.Stroke" Color="#696969"/>
    <SolidColorBrush x:Key="Expander.Disabled.Circle.Stroke" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Disabled.Circle.Fill" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="Expander.Static.Circle.Fill" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Static.Circle.Stroke" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke" Color="#A0A0A0"/>

    <!--#endregion-->

    <!--#region ListBox / ListView -->

    <SolidColorBrush x:Key="ListBox.Static.Background" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="ListBox.Static.Border" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#E8E8E8"/>

    <SolidColorBrush x:Key="ListViewItem.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItem.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItem.MouseDown.Background">#22000000</SolidColorBrush>
    <SolidColorBrush x:Key="ListViewItem.MouseDown.Border">#22000000</SolidColorBrush>
    <SolidColorBrush x:Key="ListViewItem.MouseOver.BackgroundBrush">#33000000</SolidColorBrush>
    <SolidColorBrush x:Key="ListViewItem.MouseOver.BorderBrush">#33000000</SolidColorBrush>
    <Color x:Key="ListViewItem.MouseOver.Background">#33000000</Color>
    <Color x:Key="ListViewItem.MouseOver.Border">#33000000</Color>
    <SolidColorBrush x:Key="ListViewItem.SelectedInactive.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItem.SelectedInactive.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ListViewItem.SelectedActive.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItem.SelectedActive.Border" Color="#4A4A4A"/>

    <SolidColorBrush x:Key="CardListViewItem.Static.Background" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="CardListViewItem.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="CardListViewItem.Focused.Background" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="CardListViewItem.Focused.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="CardListViewItem.MouseOver.Background" Color="#F5F5F5"></SolidColorBrush>
    <SolidColorBrush x:Key="CardListViewItem.MouseOver.Border" Color="Transparent"></SolidColorBrush>
    <SolidColorBrush x:Key="CardListViewItem.SelectedInactive.Background" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="CardListViewItem.SelectedInactive.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="CardListViewItem.SelectedActive.Background" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="CardListViewItem.SelectedActive.Border" Color="#4A4A4A"/>

    <!--#endregion-->

    <!--#region RadioButton -->

    <SolidColorBrush x:Key="RadioButton.Static.Border" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="RadioButton.MouseOver.Border" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Border" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Border" Color="#B8B8B8"/>

    <SolidColorBrush x:Key="RadioButton.Static.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RadioButton.MouseOver.Background" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Background" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Background" Color="#F0F0F0"/>

    <SolidColorBrush x:Key="RadioButton.MouseOver.Glyph" Color="#696969"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Glyph" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Glyph" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="RadioButton.Static.Glyph" Color="#1A1A1A"/>

    <!--#endregion-->

    <!--#region Menu -->

    <SolidColorBrush x:Key="MenuBar.Background" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Menu.Static.Background" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Menu.Static.Border" Color="#E0E0E0" />

    <SolidColorBrush x:Key="MenuItem.Context.Selected.Border" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="MenuItem.Context.Selected.Background" Color="#00B359"/>

    <!--#endregion-->

    <!--#region Tab Bar -->

    <SolidColorBrush x:Key="TabItem.Selected.Background" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="TabItem.Selected.Border" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TabItem.Static.Background" Color="#F5F5F5" />
    <SolidColorBrush x:Key="TabItem.Static.Border" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Background" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Border" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Background" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Border" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="TabItem.Selected.Border2" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TabItem.Selected.Background2" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="TabItem.Static.Foreground" Color="#696969"/>
    <SolidColorBrush x:Key="TabItem.Selected.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Foreground" Color="#B0B0B0"/>

    <!--#endregion-->

    <!--#region Context Menu -->

    <SolidColorBrush x:Key="ContentMenu.Static.Background" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ContentMenu.Static.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ContentMenu.Static.BorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ContentMenu.MenuTPL.Background" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ContextMenu.Selected.Background" Color="#00B359"/>
    <SolidColorBrush x:Key="ContextMenu.Checked.Glyph" Color="#1A1A1A"/>

    <!--#endregion-->

    <!--#region News Feed -->

    <SolidColorBrush x:Key="MCNetFeedItem.Static.Background" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="MCNetFeedItem.Selected.Background" Color="#EEEEEE"/>

    <!--#endregion-->

    <!--#region Panel Button -->

    <SolidColorBrush x:Key="PanelButton.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="PanelButton.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="PanelButton.Static.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="PanelButton.MouseOver.Background" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="PanelButton.MouseOver.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="PanelButton.Pressed.Background" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="PanelButton.Pressed.Border" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="PanelButton.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="PanelButton.Disabled.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="PanelButton.Disabled.Foreground" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="PanelButton.Focused.Border" Color="#4A4A4A"/>

    <!--#endregion-->

    <!--#region Dialog Mini Button -->

    <SolidColorBrush x:Key="DialogMiniButton.Static.Background" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="DialogMiniButton.Static.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="DialogMiniButton.MouseOver.Background" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="DialogMiniButton.MouseOver.Border" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="DialogMiniButton.Pressed.Background" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="DialogMiniButton.Pressed.Border" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="DialogMiniButton.Disabled.Background" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="DialogMiniButton.Disabled.Border" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="DialogMiniButton.Disabled.Foreground" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="DialogMiniButton.Static.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DialogMiniButton.Focused.Background" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="DialogMiniButton.Focused.Border" Color="#C8C8C8"/>

    <!--#endregion-->

    <!--#region Sidebar Button -->

    <Color x:Key="ButtonSide.MainBackground">#EEEEEE</Color>
    <SolidColorBrush x:Key="ButtonSide.Static.Background" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="ButtonSide.Static.Border" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ButtonSide.Static.Foreground" Color="#1A1A1A"/>
    <Color x:Key="ButtonSide.MouseOver.Background">#E0E0E0</Color>
    <Color x:Key="ButtonSide.MouseOver.Border">#D0D0D0</Color>
    <SolidColorBrush x:Key="ButtonSide.Pressed.Background" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="ButtonSide.Pressed.Border" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="ButtonSide.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonSide.Disabled.Border" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="ButtonSide.Disabled.Foreground" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="ButtonSide.Focused.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ButtonSide.Focused.Background" Color="#E0E0E0"/>

    <!--#endregion-->

    <!--#region Play Button -->

    <ImageBrush x:Key="PlayButton.Static.Background" ImageSource="/XylarBedrock;component/resources/images/ui/panels/MainPagePlayButton.png" Stretch="Uniform"/>
    <ImageBrush x:Key="PlayButton.MouseOver.Background" ImageSource="/XylarBedrock;component/resources/images/ui/panels/MainPagePlayButtonOver.png" Stretch="Uniform"/>
    <ImageBrush x:Key="PlayButton.Pressed.Background" ImageSource="/XylarBedrock;component/resources/images/ui/panels/MainPagePlayButtonPressed.png" Stretch="Uniform"/>
    <ImageBrush x:Key="PlayButton.Focused.MouseOver.Background" ImageSource="/XylarBedrock;component/resources/images/ui/panels/MainPagePlayButtonFocusOver.png" Stretch="Uniform"/>

    <!--#endregion-->

    <!--#region Dialog Buttons -->

    <SolidColorBrush x:Key="DialogButton.Static.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DialogButton.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="DialogButton.Static.Border" Color="#B0B0B0"/>

    <SolidColorBrush x:Key="DialogButton.MouseOver.Background" Color="#22000000"/>
    <SolidColorBrush x:Key="DialogButton.MouseOver.Border" Color="#A0A0A0"/>

    <SolidColorBrush x:Key="DialogButton.Pressed.Background" Color="#11000000"/>
    <SolidColorBrush x:Key="DialogButton.Pressed.Border" Color="#A0A0A0"/>

    <SolidColorBrush x:Key="DialogButton.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="DialogButton.Disabled.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="DialogButton.Disabled.Foreground" Color="#B0B0B0"/>

    <!--#endregion-->

    <!--#region Reserved -->

    <!--#endregion-->

</ResourceDictionary>
