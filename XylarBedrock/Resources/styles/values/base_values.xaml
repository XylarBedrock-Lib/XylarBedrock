<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- WHITE MODE: white surfaces, black text, light-gray buttons. -->

    <!--#region Text / Glyphs -->

    <SolidColorBrush x:Key="PrimaryText.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="SecondaryText.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TertiaryText.Foreground" Color="#333333"/>
    <SolidColorBrush x:Key="DisabledText.Foreground" Color="#8A8A8A"/>

    <SolidColorBrush x:Key="Seperator.Background" Color="#D6D6D6"/>

    <SolidColorBrush x:Key="OveralElements.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusableElement.Background" Color="#F2F2F2"/>

    <!--#endregion-->

    <!--#region Backgrounds -->

    <SolidColorBrush x:Key="Background.Primary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Background.Secondary" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="Background.Dialog" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Background.Tertiary" Color="#FFFFFF"/>

    <!--#endregion-->

    <!--#region Option Mark -->

    <SolidColorBrush x:Key="OptionMark.Static.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OptionMark.Static.Border" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="OptionMark.Static.Glyph" Color="#000000"/>

    <SolidColorBrush x:Key="OptionMark.MouseOver.Background" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Border" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Glyph" Color="#000000"/>

    <SolidColorBrush x:Key="OptionMark.Pressed.Background" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Border" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Glyph" Color="#000000"/>

    <SolidColorBrush x:Key="OptionMark.Static.Checked.Background" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="OptionMark.Static.Checked.Border" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="OptionMark.Static.Checked.Glyph" Color="#000000"/>

    <SolidColorBrush x:Key="OptionMark.MouseOver.Checked.Background" Color="#C4C4C4"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Checked.Border" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Checked.Glyph" Color="#000000"/>

    <SolidColorBrush x:Key="OptionMark.Pressed.Checked.Background" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Checked.Border" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Checked.Glyph" Color="#000000"/>

    <SolidColorBrush x:Key="OptionMark.Focused.Border" Color="#000000"/>

    <!--#endregion-->

    <!--#region Generic Button -->

    <SolidColorBrush x:Key="Button.Static.Background" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="Button.Static.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#DADADA"/>
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#CECECE"/>
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#8A8A8A"/>

    <!--#endregion-->

    <!--#region ScrollBar -->

    <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double>
    <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">8</sys:Double>

    <SolidColorBrush x:Key="ScrollBar.Static.Background" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Border" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Glyph" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Glyph" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Glyph" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Glyph" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Background" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Border" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Background" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Border" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Background" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Border" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="#C4C4C4"/>

    <!--#endregion-->

    <!--#region Combobox -->

    <sys:Double x:Key="ComboBox_VerticalScrollBarWidthKey">5</sys:Double>
    <sys:Double x:Key="ComboBox_HorizontalScrollBarHeightKey">5</sys:Double>

    <SolidColorBrush x:Key="ComboBox.Static.Background" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="ComboBox.Static.Border" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="#000000"/>

    <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Border" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="#000000"/>

    <SolidColorBrush x:Key="ComboBox.Pressed.Background" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Border" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="#000000"/>

    <SolidColorBrush x:Key="ComboBox.Focused.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBox.Focused.Border" Color="#000000"/>
    <SolidColorBrush x:Key="ComboBox.Focused.Glyph" Color="#000000"/>

    <SolidColorBrush x:Key="ComboBoxItem.Selected.Background" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ComboBoxItem.Selected.Border" Color="#E0E0E0"/>

    <SolidColorBrush x:Key="ScrollBar_Combobox.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBar_Combobox.Static.Border" Color="Transparent"/>

    <SolidColorBrush x:Key="ScrollBar_Combobox.MouseOver.Thumb" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="ScrollBar_Combobox.Pressed.Thumb" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="ScrollBar_Combobox.Static.Thumb" Color="#C4C4C4"/>

    <SolidColorBrush x:Key="ComboBox.Dropdown.Static.Background" Color="#FFFFFF"/>

    <!--#endregion-->

    <!--#region TextBox -->

    <SolidColorBrush x:Key="TextBox.Static.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="TextBox.Static.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#CFCFCF"/>

    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="TextBox.MouseOver.Background" Color="#FAFAFA"/>

    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#000000"/>
    <SolidColorBrush x:Key="TextBox.Focus.Background" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextBox.SelectionBrush" Color="#9FC3E0"/>

    <!--#endregion-->

    <!--#region Expander -->

    <SolidColorBrush x:Key="Expander.MouseOver.Circle.Stroke" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.MouseOver.Circle.Fill" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke" Color="#000000"/>
    <SolidColorBrush x:Key="Expander.Pressed.Circle.Stroke" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Pressed.Circle.Fill" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Pressed.Arrow.Stroke" Color="#333333"/>
    <SolidColorBrush x:Key="Expander.Disabled.Circle.Stroke" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Disabled.Circle.Fill" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="Expander.Static.Circle.Fill" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Static.Circle.Stroke" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke" Color="#1A1A1A"/>

    <!--#endregion-->

    <!--#region ListBox / ListView -->

    <SolidColorBrush x:Key="ListBox.Static.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ListBox.Static.Border" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#E6E6E6"/>

    <SolidColorBrush x:Key="ListViewItem.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItem.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItem.MouseDown.Background">#14000000</SolidColorBrush>
    <SolidColorBrush x:Key="ListViewItem.MouseDown.Border">#14000000</SolidColorBrush>
    <SolidColorBrush x:Key="ListViewItem.MouseOver.BackgroundBrush">#1F000000</SolidColorBrush>
    <SolidColorBrush x:Key="ListViewItem.MouseOver.BorderBrush">#1F000000</SolidColorBrush>
    <Color x:Key="ListViewItem.MouseOver.Background">#1F000000</Color>
    <Color x:Key="ListViewItem.MouseOver.Border">#1F000000</Color>
    <SolidColorBrush x:Key="ListViewItem.SelectedInactive.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItem.SelectedInactive.Border" Color="#000000"/>
    <SolidColorBrush x:Key="ListViewItem.SelectedActive.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItem.SelectedActive.Border" Color="#000000"/>

    <SolidColorBrush x:Key="CardListViewItem.Static.Background" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="CardListViewItem.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="CardListViewItem.Focused.Background" Color="#EDEDED"/>
    <SolidColorBrush x:Key="CardListViewItem.Focused.Border" Color="#000000"/>
    <SolidColorBrush x:Key="CardListViewItem.MouseOver.Background" Color="#EFEFEF"></SolidColorBrush>
    <SolidColorBrush x:Key="CardListViewItem.MouseOver.Border" Color="Transparent"></SolidColorBrush>
    <SolidColorBrush x:Key="CardListViewItem.SelectedInactive.Background" Color="#EDEDED"/>
    <SolidColorBrush x:Key="CardListViewItem.SelectedInactive.Border" Color="#000000"/>
    <SolidColorBrush x:Key="CardListViewItem.SelectedActive.Background" Color="#EDEDED"/>
    <SolidColorBrush x:Key="CardListViewItem.SelectedActive.Border" Color="#000000"/>

    <!--#endregion-->

    <!--#region RadioButton -->

    <SolidColorBrush x:Key="RadioButton.Static.Border" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="RadioButton.MouseOver.Border" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Border" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Border" Color="#8A8A8A"/>

    <SolidColorBrush x:Key="RadioButton.Static.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RadioButton.MouseOver.Background" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Background" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Background" Color="#EAEAEA"/>

    <SolidColorBrush x:Key="RadioButton.MouseOver.Glyph" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Glyph" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Glyph" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="RadioButton.Static.Glyph" Color="#000000"/>

    <!--#endregion-->

    <!--#region Menu -->

    <SolidColorBrush x:Key="MenuBar.Background" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#000000" />
    <SolidColorBrush x:Key="Menu.Static.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Menu.Static.Border" Color="#D6D6D6" />

    <SolidColorBrush x:Key="MenuItem.Context.Selected.Border" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="MenuItem.Context.Selected.Background" Color="#E6E6E6"/>

    <!--#endregion-->

    <!--#region Tab Bar -->

    <SolidColorBrush x:Key="TabItem.Selected.Background" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="TabItem.Selected.Border" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="TabItem.Static.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabItem.Static.Border" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Background" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Border" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Border" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="TabItem.Selected.Border2" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="TabItem.Selected.Background2" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="TabItem.Static.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TabItem.Selected.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Foreground" Color="#8A8A8A"/>

    <!--#endregion-->

    <!--#region Toolbar Buttons (Play / FAQ / News / Settings tabs) -->

    <SolidColorBrush x:Key="ToolbarButton.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ToolbarButton.Static.Border" Color="#FF008542"/>
    <SolidColorBrush x:Key="ToolbarButton.Static.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ToolbarButton.MouseOver.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="ToolbarButton.Selected.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="ToolbarButton.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ToolbarButton.Disabled.Border" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="ToolbarButton.Disabled.Foreground" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="ToolbarButton.Focused.Border" Color="#000000"/>

    <!--#endregion-->

    <!--#region Close Buttons -->

    <SolidColorBrush x:Key="CloseButton.Static.Background" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="CloseButton.Static.Border" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="CloseButton.Static.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="CloseButton.MouseOver.Background" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="CloseButton.MouseOver.Border" Color="#000000"/>
    <SolidColorBrush x:Key="CloseButton.Pressed.Background" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="CloseButton.Pressed.Border" Color="#000000"/>
    <SolidColorBrush x:Key="CloseButton.Disabled.Background" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="CloseButton.Disabled.Border" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="CloseButton.Disabled.Foreground" Color="#88000000"/>

    <SolidColorBrush x:Key="ClosePopupButton.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ClosePopupButton.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ClosePopupButton.Static.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="ClosePopupButton.MouseOver.Background" Color="#DADADA"/>
    <SolidColorBrush x:Key="ClosePopupButton.MouseOver.Border" Color="#DADADA"/>
    <SolidColorBrush x:Key="ClosePopupButton.Pressed.Background" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="ClosePopupButton.Pressed.Border" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="ClosePopupButton.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ClosePopupButton.Disabled.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ClosePopupButton.Disabled.Foreground" Color="#88000000"/>

    <!--#endregion-->

    <!--#region Link / TextBox Buttons -->

    <SolidColorBrush x:Key="LinkButton.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="LinkButton.MouseOver.Background" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="LinkButton.Pressed.Background" Color="#DADADA"/>

    <SolidColorBrush x:Key="TextBoxButton.Foreground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextBoxButton.MouseOver.Background" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="TextBoxButton.Pressed.Background" Color="#DADADA"/>
    <SolidColorBrush x:Key="TextBoxButton.Disabled.Foreground" Color="#8A8A8A"/>

    <!--#endregion-->

    <!--#region Store / Mods big buttons -->

    <SolidColorBrush x:Key="StoreButton.Static.Background" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="StoreButton.MouseOver.Background" Color="#DADADA"/>
    <SolidColorBrush x:Key="StoreButton.Pressed.Background" Color="#CECECE"/>
    <SolidColorBrush x:Key="StoreButton.Static.Border" Color="#BDBDBD"/>

    <SolidColorBrush x:Key="ModsButton.Static.Background" Color="#F28B82"/>
    <SolidColorBrush x:Key="ModsButton.MouseOver.Background" Color="#F6A39C"/>
    <SolidColorBrush x:Key="ModsButton.Pressed.Background" Color="#E57368"/>
    <SolidColorBrush x:Key="ModsButton.Static.Border" Color="#C0504A"/>

    <!--#endregion-->

    <!--#region Context Menu -->

    <SolidColorBrush x:Key="ContentMenu.Static.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ContentMenu.Static.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="ContentMenu.Static.BorderBrush" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="ContentMenu.MenuTPL.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ContextMenu.Selected.Background" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="ContextMenu.Checked.Glyph" Color="#000000"/>

    <!--#endregion-->

    <!--#region News Feed -->

    <SolidColorBrush x:Key="MCNetFeedItem.Static.Background" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="MCNetFeedItem.Selected.Background" Color="#EDEDED"/>

    <!--#endregion-->

    <!--#region Panel Button -->

    <SolidColorBrush x:Key="PanelButton.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="PanelButton.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="PanelButton.Static.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="PanelButton.MouseOver.Background" Color="#EDEDED"/>
    <SolidColorBrush x:Key="PanelButton.MouseOver.Border" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="PanelButton.Pressed.Background" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="PanelButton.Pressed.Border" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="PanelButton.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="PanelButton.Disabled.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="PanelButton.Disabled.Foreground" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="PanelButton.Focused.Border" Color="#000000"/>

    <!--#endregion-->

    <!--#region Dialog Mini Button -->

    <SolidColorBrush x:Key="DialogMiniButton.Static.Background" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="DialogMiniButton.Static.Border" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="DialogMiniButton.MouseOver.Background" Color="#DADADA"/>
    <SolidColorBrush x:Key="DialogMiniButton.MouseOver.Border" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="DialogMiniButton.Pressed.Background" Color="#CECECE"/>
    <SolidColorBrush x:Key="DialogMiniButton.Pressed.Border" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="DialogMiniButton.Disabled.Background" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="DialogMiniButton.Disabled.Border" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="DialogMiniButton.Disabled.Foreground" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="DialogMiniButton.Static.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="DialogMiniButton.Focused.Background" Color="#DADADA"/>
    <SolidColorBrush x:Key="DialogMiniButton.Focused.Border" Color="#BDBDBD"/>

    <!--#endregion-->

    <!--#region Sidebar Button -->

    <Color x:Key="ButtonSide.MainBackground">#F4F4F4</Color>
    <SolidColorBrush x:Key="ButtonSide.Static.Background" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="ButtonSide.Static.Border" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="ButtonSide.Static.Foreground" Color="#000000"/>
    <Color x:Key="ButtonSide.MouseOver.Background">#E6E6E6</Color>
    <Color x:Key="ButtonSide.MouseOver.Border">#D6D6D6</Color>
    <SolidColorBrush x:Key="ButtonSide.MouseOver.BackgroundBrush" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="ButtonSide.MouseOver.BorderBrush" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="ButtonSide.Pressed.Background" Color="#DADADA"/>
    <SolidColorBrush x:Key="ButtonSide.Pressed.Border" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="ButtonSide.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonSide.Disabled.Border" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="ButtonSide.Disabled.Foreground" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="ButtonSide.Focused.Border" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="ButtonSide.Focused.Background" Color="#E6E6E6"/>

    <!--#endregion-->

    <!--#region Play Button -->

    <ImageBrush x:Key="PlayButton.Static.Background" ImageSource="/XylarBedrock;component/resources/images/ui/panels/MainPagePlayButton.png" Stretch="Uniform"/>
    <ImageBrush x:Key="PlayButton.MouseOver.Background" ImageSource="/XylarBedrock;component/resources/images/ui/panels/MainPagePlayButtonOver.png" Stretch="Uniform"/>
    <ImageBrush x:Key="PlayButton.Pressed.Background" ImageSource="/XylarBedrock;component/resources/images/ui/panels/MainPagePlayButtonPressed.png" Stretch="Uniform"/>
    <ImageBrush x:Key="PlayButton.Focused.MouseOver.Background" ImageSource="/XylarBedrock;component/resources/images/ui/panels/MainPagePlayButtonFocusOver.png" Stretch="Uniform"/>

    <!--#endregion-->

    <!--#region Dialog Buttons -->

    <SolidColorBrush x:Key="DialogButton.Static.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="DialogButton.Static.Background" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="DialogButton.Static.Border" Color="#CFCFCF"/>

    <SolidColorBrush x:Key="DialogButton.MouseOver.Background" Color="#DADADA"/>
    <SolidColorBrush x:Key="DialogButton.MouseOver.Border" Color="#BDBDBD"/>

    <SolidColorBrush x:Key="DialogButton.Pressed.Background" Color="#CECECE"/>
    <SolidColorBrush x:Key="DialogButton.Pressed.Border" Color="#A8A8A8"/>

    <SolidColorBrush x:Key="DialogButton.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="DialogButton.Disabled.Border" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="DialogButton.Disabled.Foreground" Color="#8A8A8A"/>

    <!--#endregion-->

</ResourceDictionary>
