<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--#region Text / Glyphs -->

    <SolidColorBrush x:Key="PrimaryText.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryText.Foreground" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="TertiaryText.Foreground" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="DisabledText.Foreground" Color="#606060"/>

    <SolidColorBrush x:Key="Seperator.Background" Color="#3F3F3F"/>

    <SolidColorBrush x:Key="OveralElements.Background" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="FocusableElement.Background" Color="#333333"/>

    <!--#endregion-->

    <!--#region Backgrounds -->

    <SolidColorBrush x:Key="Background.Primary" Color="#202020"/>
    <SolidColorBrush x:Key="Background.Secondary" Color="#252525"/>
    <SolidColorBrush x:Key="Background.Dialog" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Background.Tertiary" Color="#1A1A1A"/>

    <!--#endregion-->

    <!--#region Option Mark -->

    <SolidColorBrush x:Key="OptionMark.Static.Background" Color="#333333"/>
    <SolidColorBrush x:Key="OptionMark.Static.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="OptionMark.Static.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="OptionMark.MouseOver.Background" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Border" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="OptionMark.Pressed.Background" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Border" Color="#404040"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="OptionMark.Static.Checked.Background" Color="#505050"/>
    <SolidColorBrush x:Key="OptionMark.Static.Checked.Border" Color="#505050"/>
    <SolidColorBrush x:Key="OptionMark.Static.Checked.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="OptionMark.MouseOver.Checked.Background" Color="#606060"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Checked.Border" Color="#606060"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Checked.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="OptionMark.Pressed.Checked.Background" Color="#404040"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Checked.Border" Color="#404040"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Checked.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="OptionMark.Focused.Border" Color="#FFFFFF"/>

    <!--#endregion-->

    <!--#region Generic Button -->

    <SolidColorBrush x:Key="Button.Static.Background" Color="#333333"/>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Button.Static.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#404040"/>
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#333333"/>
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#606060"/>

    <!--#endregion-->

    <!--#region ScrollBar -->

    <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double>
    <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">8</sys:Double>

    <SolidColorBrush x:Key="ScrollBar.Static.Background" Color="#202020"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Border" Color="#252525"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Glyph" Color="#606060"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Glyph" Color="#808080"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Glyph" Color="#333333"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Glyph" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Background" Color="#202020"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Border" Color="#252525"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Background" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Border" Color="#202020"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Background" Color="#151515"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Border" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="#3F3F3F"/>

    <!--#endregion-->

    <!--#region Combobox -->

    <sys:Double x:Key="ComboBox_VerticalScrollBarWidthKey">5</sys:Double>
    <sys:Double x:Key="ComboBox_HorizontalScrollBarHeightKey">5</sys:Double>

    <SolidColorBrush x:Key="ComboBox.Static.Background" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ComboBox.Static.Border" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="#333333"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ComboBox.Pressed.Background" Color="#333333"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Border" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ComboBox.Focused.Background" Color="#202020"/>
    <SolidColorBrush x:Key="ComboBox.Focused.Border" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboBox.Focused.Glyph" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ComboBoxItem.Selected.Background" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ComboBoxItem.Selected.Border" Color="#4A4A4A"/>

    <SolidColorBrush x:Key="ScrollBar_Combobox.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBar_Combobox.Static.Border" Color="Transparent"/>

    <SolidColorBrush x:Key="ScrollBar_Combobox.MouseOver.Thumb" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="ScrollBar_Combobox.Pressed.Thumb" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ScrollBar_Combobox.Static.Thumb" Color="#3F3F3F"/>

    <SolidColorBrush x:Key="ComboBox.Dropdown.Static.Background" Color="#2A2A2A"/>

    <!--#endregion-->

    <!--#region TextBox -->

    <SolidColorBrush x:Key="TextBox.Static.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBox.Static.Background" Color="#202020"/>
    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#3F3F3F"/>

    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="TextBox.MouseOver.Background" Color="#252525"/>

    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBox.Focus.Background" Color="#202020"/>

    <SolidColorBrush x:Key="TextBox.SelectionBrush" Color="#4D7D9F"/>

    <!--#endregion-->

    <!--#region Expander -->

    <SolidColorBrush x:Key="Expander.MouseOver.Circle.Stroke" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.MouseOver.Circle.Fill" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Expander.Pressed.Circle.Stroke" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Pressed.Circle.Fill" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Pressed.Arrow.Stroke" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="Expander.Disabled.Circle.Stroke" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Disabled.Circle.Fill" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Expander.Static.Circle.Fill" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Static.Circle.Stroke" Color="Transparent"/>
    <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke" Color="#B0B0B0"/>

    <!--#endregion-->

    <!--#region ListBox / ListView -->

    <SolidColorBrush x:Key="ListBox.Static.Background" Color="#252525"/>
    <SolidColorBrush x:Key="ListBox.Static.Border" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#202020"/>
    <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#2A2A2A"/>

    <SolidColorBrush x:Key="ListViewItem.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItem.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItem.MouseDown.Background">#22FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ListViewItem.MouseDown.Border">#22FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ListViewItem.MouseOver.BackgroundBrush">#33FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ListViewItem.MouseOver.BorderBrush">#33FFFFFF</SolidColorBrush>
    <Color x:Key="ListViewItem.MouseOver.Background">#33FFFFFF</Color>
    <Color x:Key="ListViewItem.MouseOver.Border">#33FFFFFF</Color>
    <SolidColorBrush x:Key="ListViewItem.SelectedInactive.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItem.SelectedInactive.Border" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ListViewItem.SelectedActive.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ListViewItem.SelectedActive.Border" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="CardListViewItem.Static.Background" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="CardListViewItem.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="CardListViewItem.Focused.Background" Color="#333333"/>
    <SolidColorBrush x:Key="CardListViewItem.Focused.Border" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardListViewItem.MouseOver.Background" Color="#3A3A3A"></SolidColorBrush>
    <SolidColorBrush x:Key="CardListViewItem.MouseOver.Border" Color="Transparent"></SolidColorBrush>
    <SolidColorBrush x:Key="CardListViewItem.SelectedInactive.Background" Color="#333333"/>
    <SolidColorBrush x:Key="CardListViewItem.SelectedInactive.Border" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardListViewItem.SelectedActive.Background" Color="#333333"/>
    <SolidColorBrush x:Key="CardListViewItem.SelectedActive.Border" Color="#FFFFFF"/>

    <!--#endregion-->

    <!--#region RadioButton -->

    <SolidColorBrush x:Key="RadioButton.Static.Border" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="RadioButton.MouseOver.Border" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Border" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Border" Color="#4A4A4A"/>

    <SolidColorBrush x:Key="RadioButton.Static.Background" Color="#202020"/>
    <SolidColorBrush x:Key="RadioButton.MouseOver.Background" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Background" Color="#252525"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Background" Color="#1A1A1A"/>

    <SolidColorBrush x:Key="RadioButton.MouseOver.Glyph" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Glyph" Color="#606060"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Glyph" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="RadioButton.Static.Glyph" Color="#FFFFFF"/>

    <!--#endregion-->

    <!--#region Menu -->

    <SolidColorBrush x:Key="MenuBar.Background" Color="#2A2A2A"/>

    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Menu.Static.Background" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Menu.Static.Border" Color="#3F3F3F" />

    <SolidColorBrush x:Key="MenuItem.Context.Selected.Border" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="MenuItem.Context.Selected.Background" Color="#4A4A4A"/>

    <!--#endregion-->

    <!--#region Tab Bar -->

    <SolidColorBrush x:Key="TabItem.Selected.Background" Color="#333333"/>
    <SolidColorBrush x:Key="TabItem.Selected.Border" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="TabItem.Static.Background" Color="#202020" />
    <SolidColorBrush x:Key="TabItem.Static.Border" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Background" Color="#252525"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Border" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Background" Color="#202020"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Border" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="TabItem.Selected.Border2" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="TabItem.Selected.Background2" Color="#333333"/>
    <SolidColorBrush x:Key="TabItem.Static.Foreground" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="TabItem.Selected.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Foreground" Color="#606060"/>

    <!--#endregion-->

    <!--#region Toolbar Buttons (Play / FAQ / News / Settings tabs) -->

    <SolidColorBrush x:Key="ToolbarButton.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ToolbarButton.Static.Border" Color="#FF008542"/>
    <SolidColorBrush x:Key="ToolbarButton.Static.Foreground" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="ToolbarButton.MouseOver.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolbarButton.Selected.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolbarButton.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ToolbarButton.Disabled.Border" Color="#FFADB2B5"/>
    <SolidColorBrush x:Key="ToolbarButton.Disabled.Foreground" Color="#FF838383"/>
    <SolidColorBrush x:Key="ToolbarButton.Focused.Border" Color="#FFFFFF"/>

    <!--#endregion-->

    <!--#region Close Buttons -->

    <SolidColorBrush x:Key="CloseButton.Static.Background" Color="#FF353535"/>
    <SolidColorBrush x:Key="CloseButton.Static.Border" Color="#FF353535"/>
    <SolidColorBrush x:Key="CloseButton.Static.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CloseButton.MouseOver.Background" Color="#FF838383"/>
    <SolidColorBrush x:Key="CloseButton.MouseOver.Border" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CloseButton.Pressed.Background" Color="#FF838383"/>
    <SolidColorBrush x:Key="CloseButton.Pressed.Border" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CloseButton.Disabled.Background" Color="#FF353535"/>
    <SolidColorBrush x:Key="CloseButton.Disabled.Border" Color="#FF353535"/>
    <SolidColorBrush x:Key="CloseButton.Disabled.Foreground" Color="#88FFFFFF"/>

    <SolidColorBrush x:Key="ClosePopupButton.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ClosePopupButton.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ClosePopupButton.Static.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ClosePopupButton.MouseOver.Background" Color="#FF838383"/>
    <SolidColorBrush x:Key="ClosePopupButton.MouseOver.Border" Color="#FF838383"/>
    <SolidColorBrush x:Key="ClosePopupButton.Pressed.Background" Color="#FF838383"/>
    <SolidColorBrush x:Key="ClosePopupButton.Pressed.Border" Color="#FF838383"/>
    <SolidColorBrush x:Key="ClosePopupButton.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ClosePopupButton.Disabled.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ClosePopupButton.Disabled.Foreground" Color="#88FFFFFF"/>

    <!--#endregion-->

    <!--#region Link / TextBox Buttons -->

    <SolidColorBrush x:Key="LinkButton.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LinkButton.MouseOver.Background" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="LinkButton.Pressed.Background" Color="#515151"/>

    <SolidColorBrush x:Key="TextBoxButton.Foreground" Color="#D3D3D3"/>
    <SolidColorBrush x:Key="TextBoxButton.MouseOver.Background" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="TextBoxButton.Pressed.Background" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="TextBoxButton.Disabled.Foreground" Color="#808080"/>

    <!--#endregion-->

    <!--#region Store / Mods big buttons -->

    <SolidColorBrush x:Key="StoreButton.Static.Background" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="StoreButton.MouseOver.Background" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="StoreButton.Pressed.Background" Color="#121212"/>
    <SolidColorBrush x:Key="StoreButton.Static.Border" Color="#151515"/>

    <SolidColorBrush x:Key="ModsButton.Static.Background" Color="#5A1717"/>
    <SolidColorBrush x:Key="ModsButton.MouseOver.Background" Color="#742020"/>
    <SolidColorBrush x:Key="ModsButton.Pressed.Background" Color="#441111"/>
    <SolidColorBrush x:Key="ModsButton.Static.Border" Color="#2E0C0C"/>

    <!--#endregion-->

    <!--#region Context Menu -->

    <SolidColorBrush x:Key="ContentMenu.Static.Background" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ContentMenu.Static.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ContentMenu.Static.BorderBrush" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="ContentMenu.MenuTPL.Background" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ContextMenu.Selected.Background" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ContextMenu.Checked.Glyph" Color="#FFFFFF"/>

    <!--#endregion-->

    <!--#region News Feed -->

    <SolidColorBrush x:Key="MCNetFeedItem.Static.Background" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="MCNetFeedItem.Selected.Background" Color="#333333"/>

    <!--#endregion-->

    <!--#region Panel Button -->

    <SolidColorBrush x:Key="PanelButton.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="PanelButton.Static.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="PanelButton.Static.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelButton.MouseOver.Background" Color="#333333"/>
    <SolidColorBrush x:Key="PanelButton.MouseOver.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="PanelButton.Pressed.Background" Color="#202020"/>
    <SolidColorBrush x:Key="PanelButton.Pressed.Border" Color="#303030"/>
    <SolidColorBrush x:Key="PanelButton.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="PanelButton.Disabled.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="PanelButton.Disabled.Foreground" Color="#606060"/>
    <SolidColorBrush x:Key="PanelButton.Focused.Border" Color="#FFFFFF"/>

    <!--#endregion-->

    <!--#region Dialog Mini Button -->

    <SolidColorBrush x:Key="DialogMiniButton.Static.Background" Color="#333333"/>
    <SolidColorBrush x:Key="DialogMiniButton.Static.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="DialogMiniButton.MouseOver.Background" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="DialogMiniButton.MouseOver.Border" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="DialogMiniButton.Pressed.Background" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="DialogMiniButton.Pressed.Border" Color="#404040"/>
    <SolidColorBrush x:Key="DialogMiniButton.Disabled.Background" Color="#202020"/>
    <SolidColorBrush x:Key="DialogMiniButton.Disabled.Border" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="DialogMiniButton.Disabled.Foreground" Color="#606060"/>
    <SolidColorBrush x:Key="DialogMiniButton.Static.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DialogMiniButton.Focused.Background" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="DialogMiniButton.Focused.Border" Color="#5A5A5A"/>

    <!--#endregion-->

    <!--#region Sidebar Button -->

    <Color x:Key="ButtonSide.MainBackground">#333333</Color>
    <SolidColorBrush x:Key="ButtonSide.Static.Background" Color="#333333"/>
    <SolidColorBrush x:Key="ButtonSide.Static.Border" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="ButtonSide.Static.Foreground" Color="#FFFFFF"/>
    <Color x:Key="ButtonSide.MouseOver.Background">#3A3A3A</Color>
    <Color x:Key="ButtonSide.MouseOver.Border">#4A4A4A</Color>
    <SolidColorBrush x:Key="ButtonSide.MouseOver.BackgroundBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ButtonSide.MouseOver.BorderBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ButtonSide.Pressed.Background" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ButtonSide.Pressed.Border" Color="#303030"/>
    <SolidColorBrush x:Key="ButtonSide.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonSide.Disabled.Border" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ButtonSide.Disabled.Foreground" Color="#606060"/>
    <SolidColorBrush x:Key="ButtonSide.Focused.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ButtonSide.Focused.Background" Color="#3A3A3A"/>

    <!--#endregion-->

    <!--#region Play Button -->

    <ImageBrush x:Key="PlayButton.Static.Background" ImageSource="/XylarBedrock;component/resources/images/ui/panels/MainPagePlayButton.png" Stretch="Uniform"/>
    <ImageBrush x:Key="PlayButton.MouseOver.Background" ImageSource="/XylarBedrock;component/resources/images/ui/panels/MainPagePlayButtonOver.png" Stretch="Uniform"/>
    <ImageBrush x:Key="PlayButton.Pressed.Background" ImageSource="/XylarBedrock;component/resources/images/ui/panels/MainPagePlayButtonPressed.png" Stretch="Uniform"/>
    <ImageBrush x:Key="PlayButton.Focused.MouseOver.Background" ImageSource="/XylarBedrock;component/resources/images/ui/panels/MainPagePlayButtonFocusOver.png" Stretch="Uniform"/>

    <!--#endregion-->

    <!--#region Dialog Buttons -->

    <SolidColorBrush x:Key="DialogButton.Static.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DialogButton.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="DialogButton.Static.Border" Color="#5A5A5A"/>

    <SolidColorBrush x:Key="DialogButton.MouseOver.Background" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="DialogButton.MouseOver.Border" Color="#7A7A7A"/>

    <SolidColorBrush x:Key="DialogButton.Pressed.Background" Color="#11FFFFFF"/>
    <SolidColorBrush x:Key="DialogButton.Pressed.Border" Color="#7A7A7A"/>

    <SolidColorBrush x:Key="DialogButton.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="DialogButton.Disabled.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="DialogButton.Disabled.Foreground" Color="#606060"/>

    <!--#endregion-->

    <!--#endregion-->

</ResourceDictionary>
