<Page x:Class="XylarBedrock.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:viewModels="clr-namespace:XylarBedrock.ViewModels"
      xmlns:com="clr-namespace:JemExtensions.WPF.Behaviours;assembly=JemExtensions"
      xmlns:conv="clr-namespace:JemExtensions.WPF.Converters;assembly=JemExtensions"
      xmlns:controls="clr-namespace:XylarBedrock.Pages.Toolbar"
      xmlns:wincontrols="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="MainPage"
      d:DataContext="{d:DesignInstance Type=viewModels:MainDataModel}"
      mc:Ignorable="d"
      Background="{DynamicResource Background.Primary}">

    <Page.Resources>
        <wincontrols:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InvertableBooleanToVisibilityConverter x:Key="ReverseBoolToVis" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid Grid.Column="0"
              Background="{DynamicResource Background.Primary}"
              HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="buttonStackPanel"
                        Grid.Row="0"
                        Background="{DynamicResource Background.Primary}"
                        HorizontalAlignment="Stretch">

                <controls:Toolbar_ProfileButton
                    x:Name="ProfileButton"
                    IsEnabled="{Binding Source={x:Static viewModels:MainDataModel.Default},
                                        Path=ProgressBarState.AllowEditing,
                                        Mode=OneWay}" />

                <controls:Toolbar_AddonsButton
                    x:Name="AddonsButton"
                    Click="AddonsButton_Click" />

                <controls:Toolbar_NewsButton
                    x:Name="NewsButton"
                    Click="NewsButton_Click" />

                <controls:Toolbar_BedrockEditionButton
                    x:Name="BedrockEditionButton"
                    Click="BedrockEditionButton_Click" />

            </StackPanel>

            <controls:Toolbar_SettingsButton
                x:Name="SettingsButton"
                Grid.Row="1"
                Click="SettingsButton_Click" />

        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto"
                               MaxHeight="64" />
            </Grid.RowDefinitions>

            <!-- Background -->
            <Grid Grid.Row="0"
                  Background="{DynamicResource Background.Tertiary}" />

            <!-- Navigation Frame -->
            <Frame x:Name="MainWindowFrame"
                   Grid.Row="0"
                   com:DisableNavigation.Disable="True"
                   Focusable="False"
                   VerticalAlignment="Stretch"
                   NavigationUIVisibility="Hidden" />

            <!-- PROGRESS BAR -->
            <Grid x:Name="ProgressBarGrid"
                  Grid.Row="1"
                  Background="{DynamicResource Background.Primary}"
                  Visibility="{Binding ProgressBarState.Anim_Visibility}">

                <Grid Margin="10,8,10,22">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="progressSizeHack"
                                 Grid.Column="0"
                                 Height="32"
                                 Minimum="0"
                                 Maximum="{Binding ProgressBarState.TotalProgress}"
                                 IsIndeterminate="{Binding ProgressBarState.IsIndeterminate}"
                                 com:ProgressBarSmoother.SmoothValue="{Binding ProgressBarState.CurrentProgress}"
                                 BorderThickness="0"
                                 Foreground="#FF008542"
                                 Background="{DynamicResource Background.Secondary}"
                                 BorderBrush="{DynamicResource Seperator.Background}" />

                    <!-- Progress text -->
                    <StackPanel x:Name="progressbarcontent"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Height="32"
                                Margin="26,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"
                                Visibility="{Binding ProgressBarState.Anim_TextVisibility}">

                        <StackPanel.Resources>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                                <Setter Property="Padding"
                                        Value="0" />
                                <Setter Property="Margin"
                                        Value="0" />
                                <Setter Property="FontSize"
                                        Value="12" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryText.Foreground}" />
                                <Setter Property="FontFamily"
                                        Value="/XylarBedrock;component/Resources/fonts/#Noto Sans" />
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock d:Text="Uninstalling"
                                   Text="{Binding ProgressBarState.Description}" />

                        <TextBlock Text=" : "
                                   Visibility="{Binding ProgressBarState.ShowTextualProgress,
                                                        Converter={StaticResource BoolToVis}}" />

                        <TextBlock d:Text="0 / 1000 MB"
                                   Text="{Binding ProgressBarState.TextualProgress}"
                                   Visibility="{Binding ProgressBarState.ShowTextualProgress,
                                                        Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text=" : "
                                   Visibility="{Binding ProgressBarState.ShowInformation,
                                                        Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="["
                                   Visibility="{Binding ProgressBarState.ShowInformation,
                                                        Converter={StaticResource BoolToVis}}" />

                        <TextBlock d:Text="Files"
                                   Text="{Binding ProgressBarState.Information}"
                                   Visibility="{Binding ProgressBarState.ShowInformation,
                                                        Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="]"
                                   Visibility="{Binding ProgressBarState.ShowInformation,
                                                        Converter={StaticResource BoolToVis}}" />

                    </StackPanel>

                    <!-- Progress buttons -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Height="32">

                        <!-- Resume -->
                        <Button Height="32"
                                Width="32"
                                Padding="0"
                                Style="{DynamicResource DialogButton}"
                                Foreground="{DynamicResource PrimaryText.Foreground}"
                                Content="▶"
                                Visibility="Collapsed" />

                        <!-- Pause -->
                        <Button Height="32"
                                Width="32"
                                Padding="0"
                                Style="{DynamicResource DialogButton}"
                                Visibility="Collapsed">

                            <TextBlock Text="┃┃"
                                       Foreground="{DynamicResource PrimaryText.Foreground}"
                                       Margin="0,-3.2,0,0" />

                        </Button>

                        <!-- Cancel -->
                        <Button x:Name="CancelButton"
                                Height="32"
                                Width="32"
                                Padding="0"
                                Style="{DynamicResource DialogButton}"
                                Click="CancelButton_Click"
                                IsEnabled="{Binding Source={x:Static viewModels:MainDataModel.Default},
                                                    Path=ProgressBarState.AllowCancel,
                                                    Mode=OneWay}">

                            <TextBlock Text="❌"
                                       Foreground="{DynamicResource PrimaryText.Foreground}" />

                        </Button>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Page>